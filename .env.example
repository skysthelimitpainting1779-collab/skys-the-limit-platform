# Environment Variables Contract
# Copy to .env.local for local development.
# NEVER commit .env.local or files with real values.

# ============================================================
# NODE ENVIRONMENT
# ============================================================
NODE_ENV=development

# ============================================================
# NEXT.JS
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# CONVEX
# ============================================================
# Local: Get from `npx convex dev` output
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=organizations_REPLACE_ME
# Set the same generated value in Vercel and the matching Convex deployment.
LEAD_INTAKE_SECRET=generate_32_character_lead_intake_secret_here

# ============================================================
# AUTHENTICATION — WorkOS AuthKit
# ============================================================
WORKOS_API_KEY=sk_test_REPLACE_ME
WORKOS_CLIENT_ID=client_REPLACE_ME
WORKOS_COOKIE_PASSWORD=generate_32_character_secret_password_here
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Invitation-only organization selected by AuthKit for this environment.
WORKOS_ORGANIZATION_ID=org_REPLACE_ME

# Convex deployment only — configure with `npx convex env set`, not in Vercel.
WORKOS_WEBHOOK_SECRET=replace_with_environment_specific_webhook_secret
# Only configure if reviewed WorkOS Actions handlers are enabled.
# WORKOS_ACTION_SECRET=replace_with_environment_specific_action_secret

# ============================================================
# FILE STORAGE — Vercel Blob (Convex deployment only; isolated store per environment)
# ============================================================
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME

# ============================================================
# EMAIL — Resend (dormant until feature is activated)
# ============================================================
# RESEND_API_KEY=re_REPLACE_ME

# ============================================================
# PAYMENTS — Stripe (dormant until feature is activated)
# ============================================================
# STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ============================================================
# VERCEL
# ============================================================
# Set automatically by Vercel — do not set manually in Preview/Production
# VERCEL_ENV=preview | production | development
# VERCEL_URL=auto-set

# ============================================================
ENABLE_LIVE_EMAIL=false
ENABLE_LIVE_STRIPE=false
ENABLE_PRODUCTION_CONVEX=false
