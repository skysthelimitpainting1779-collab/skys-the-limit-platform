#!/usr/bin/env sh
# pre-push: Run full verification suite before pushing to remote

set -e

if command -v entire >/dev/null 2>&1; then
  entire hooks git pre-push "$1"
fi

BRANCH=$(git branch --show-current)
echo "▶ pre-push: verifying branch '$BRANCH'..."

# Block force-push detection is handled at remote level (GitHub rulesets)

# Run full local verification
echo "  → npm run verify:skills"
npm run verify:skills

echo "  → npm run typecheck"
npm run typecheck

echo "  → npm test"
npm test

echo "  → npm run lint"
npm run lint

echo "✓ pre-push verification passed. Pushing $BRANCH."
