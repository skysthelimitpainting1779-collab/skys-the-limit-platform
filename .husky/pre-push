#!/usr/bin/env sh
# pre-push: Run full verification suite before pushing to remote

set -e

BRANCH=$(git branch --show-current)
echo "▶ pre-push: verifying branch '$BRANCH'..."

# Block force-push detection is handled at remote level (GitHub rulesets)

# Run full local verification
echo "  → npm run verify:skills"
npm run verify:skills

echo "  → npm run typecheck"
npm run typecheck

echo "  → npm test"
npm test

echo "  → npm run lint"
npm run lint

echo "✓ pre-push verification passed. Pushing $BRANCH."

# Emergency bypass policy:
# To bypass: git push --no-verify
# REQUIRES: Written justification in PR description referencing this bypass.
# NEVER: Bypasses CI on protected branches (main, dev). Those checks remain authoritative.
