#!/usr/bin/env sh
# pre-commit: Prevent secrets, validate provenance, run staged checks

set -e

echo "▶ pre-commit: running checks..."

# 1. Block production environment files from being committed
if git diff --cached --name-only | grep -qE '\.env\.production|\.env\.prod'; then
  echo "✗ BLOCKED: Do not commit production environment files."
  echo "  Detected: $(git diff --cached --name-only | grep -E '\.env\.production|\.env\.prod')"
  exit 1
fi

# 2. Block real .env files (only .env.example and .env.test allowed)
if git diff --cached --name-only | grep -qE '^\.env$|^\.env\.local$'; then
  echo "✗ BLOCKED: Do not commit .env or .env.local files. Use .env.example."
  exit 1
fi

# 3. Scan for potential secret patterns in staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|mjs|json|yml|yaml)$' || true)
if [ -n "$STAGED_FILES" ]; then
  SECRET_HITS=$(git diff --cached -- $STAGED_FILES | grep -E '(sk_live_|pk_live_|AKIA[A-Z0-9]{16}|-----BEGIN (RSA|EC|OPENSSH) PRIVATE KEY|ghp_[a-zA-Z0-9]{36}|xoxb-|xoxp-)' || true)
  if [ -n "$SECRET_HITS" ]; then
    echo "✗ BLOCKED: Potential secret detected in staged files."
    echo "  Remove secrets before committing. Use environment variables."
    exit 1
  fi
fi

# 4. Verify asset provenance manifest is not bypassed
if git diff --cached --name-only | grep -qE '^public/(brand|images)/'; then
  if ! git diff --cached --name-only | grep -q 'public/assets-manifest.json'; then
    echo "✗ BLOCKED: New public asset added without updating public/assets-manifest.json"
    echo "  Update the manifest with Drive file ID, classification, and checksum."
    exit 1
  fi
fi

# 5. Reject large binaries (> 5MB)
git diff --cached --name-only | while read file; do
  if [ -f "$file" ]; then
    SIZE=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null || echo 0)
    if [ "$SIZE" -gt 5242880 ]; then
      echo "✗ BLOCKED: File $file is larger than 5MB ($SIZE bytes)."
      echo "  Store large assets in Vercel Blob, not in the repository."
      exit 1
    fi
  fi
done

echo "✓ pre-commit checks passed"
