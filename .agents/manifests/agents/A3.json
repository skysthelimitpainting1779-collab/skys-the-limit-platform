  "communication": { "may_message": ["A0", "S2", "V3"], "may_not_message": ["A1", "A2", "A4", "A5", "A6", "A7", "A8", "A9", "A10"] },
  "loop_budget": { "implementation": 3, "remediation": 3, "verifier": 2, "specialist": 1 },
  "circuit_breaker": { "thresholds": { "identical_failures": 2, "verifier_rejections": 2, "remediation_cycles": 3, "held_out_regressions": 1 } },
  "completion_requires": ["visual acceptance criteria", "token consistency proof", "responsive and accessibility risks addressed", "V3 PASS"],
  "hard_stops": ["broad implementation ownership", "hardcoded off-system styling", "accessibility regression", "protected eval mutation"]
}
