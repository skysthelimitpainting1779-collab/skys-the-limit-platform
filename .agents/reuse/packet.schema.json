{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "research_id", "task", "date", "current_sha", "problem", "required_capabilities", "existing_project_solution", "native_options", "official_ecosystem_options", "oss_candidates", "finalists", "recommended_decision", "research_status", "selected_candidate", "rejected_candidates", "risks", "proof_required_before_adoption", "rollback_or_exit_strategy", "rounds"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "research_id": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "date": { "format": "date" },
    "current_sha": { "pattern": "^[0-9a-f]{40}$" },
    "problem": { "type": "string", "minLength": 1 },
    "required_capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "existing_project_solution": { "type": "object", "required": ["found", "evidence"], "properties": { "found": { "type": "boolean" }, "evidence": { "type": "array", "items": { "type": "string" } } },
    "native_options": { "type": "array" },
    "official_ecosystem_options": { "type": "array" },
    "oss_candidates": { "type": "array" },
    "finalists": { "type": "array", "maxItems": 3 },
    "recommended_decision": { "enum": ["REUSE_EXISTING", "USE_NATIVE", "ADOPT", "ADAPT", "BUILD_CUSTOM", "DEFER", "REJECT"] },
    "research_status": { "enum": ["COMPLETE", "RESEARCH_EXHAUSTED"] },
    "selected_candidate": { "type": ["object", "null"] },
    "rejected_candidates": { "type": "array" },
    "risks": { "type": "array" },
    "proof_required_before_adoption": { "type": "array" },
    "rollback_or_exit_strategy": { "type": "array", "minItems": 1 },
    "rounds": { "type": "array", "minItems": 1, "maxItems": 3 }
  }
}
